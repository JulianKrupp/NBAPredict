# NBA Tracker – Umgebungsvariablen
# Als '.env' speichern und mit den Keys füllen.

# ─── API 1: BallDontLie (Spielergebnisse, Standings) ─────────────────────────
# https://www.balldontlie.io – kostenloses Tier verfügbar
BALLDONTLIE_API_KEY=

# ─── API 2: The Odds API (Wettquoten) ────────────────────────────────────────
# https://the-odds-api.com – 500 kostenlose Anfragen/Monat
ODDS_API_KEY=

# Hinweis: API 3 (stats.nba.com via nba_api) benötigt keinen API-Key.

# ─── Request-Konfiguration ───────────────────────────────────────────────────
REQUEST_TIMEOUT=10
MAX_RETRIES=3
RETRY_DELAY=1.0
CACHE_TTL=300

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/nba_tracker.log
